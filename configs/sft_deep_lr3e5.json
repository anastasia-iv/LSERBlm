{
  "model": {
    "vocab_size": 8192,
    "context_length": 512,
    "n_layers": 44,
    "d_model": 768,
    "n_heads": 12,
    "n_kv_heads": 4,
    "d_ff": 2048,
    "positional": "rope",
    "rope_theta": 10000.0,
    "norm": "rmsnorm",
    "ffn": "swiglu",
    "tie_embeddings": true,
    "dropout": 0.0,
    "norm_eps": 1e-05,
    "init_std": 0.02,
    "gradient_checkpointing": false,
    "attention_backend": "sdpa",
    "qk_norm": false,
    "block_repeats": 1
  },
  "train": {
    "mode": "sft",
    "seed": 42,
    "batch_size": 8,
    "gradient_accumulation": 4,
    "max_steps": 2323,
    "learning_rate": 3e-05,
    "min_learning_rate": 3e-06,
    "warmup_steps": 70,
    "schedule": "cosine",
    "decay_fraction": 0.2,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08,
    "weight_decay": 0.01,
    "gradient_clip": 1.0,
    "precision": "bf16",
    "allow_tf32": true,
    "compile": false,
    "eval_interval": 100,
    "eval_batches": 1,
    "save_interval": 100,
    "log_interval": 10,
    "tensorboard": true,
    "sample_new_tokens": 64,
    "sample_prompts": [
      "Контекст:\nНа столу је плава свеска.\n\nПитање: Шта се налази на столу?\nОдговор:"
    ],
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.001
  },
  "tokenizer": {
    "algorithm": "bpe",
    "vocab_size": 8192
  }
}
